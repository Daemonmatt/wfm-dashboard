# Slack (from agent-sdk slack create or manual app install)
WFM_ASK_BOT_SLACK_BOT_TOKEN=xoxb-...
WFM_ASK_BOT_SLACK_APP_TOKEN=xapp-...

# Optional: override #ask-wfm channel id
# WFM_ASK_CHANNEL_ID=C0C076Y04P2

# Optional: Slack user ids that count as @Matt (default: Matt MacInnis)
# WFM_ASK_MATT_USER_IDS=ULNDUTE4B

# Optional: extra user ids that should trigger (e.g. @wfm on-call rotation)
# WFM_ASK_EXTRA_USER_IDS=U08764LLD3L
